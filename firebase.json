{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web_admin",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Pragma", "value": "no-cache" },
          { "key": "Expires", "value": "0" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Pragma", "value": "no-cache" },
          { "key": "Expires", "value": "0" }
        ]
      },
      {
        "source": "/**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/**/*.@(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/politica-de-privacidad",
        "destination": "/politica-de-privacidad/index.html"
      },
      {
        "source": "/politica-de-privacidad/reembolso",
        "destination": "/politica-de-privacidad/reembolso.html"
      },
      {
        "source": "/politica-de-privacidad/terminos",
        "destination": "/politica-de-privacidad/terminos.html"
      },
      {
        "source": "/politica-de-privacidad/envio",
        "destination": "/politica-de-privacidad/envio.html"
      },
      {
        "source": "/politica-de-privacidad/contacto",
        "destination": "/politica-de-privacidad/contacto.html"
      },
      {
        "source": "/login/**",
        "destination": "/login/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "/inicio/**",
        "destination": "/inicio/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

