{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web_admin",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/politica-de-privacidad",
        "destination": "/politica-de-privacidad/index.html"
      },
      {
        "source": "/login/**",
        "destination": "/login/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "/inicio/**",
        "destination": "/inicio/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
